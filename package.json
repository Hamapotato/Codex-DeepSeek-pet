{
  "name": "dsh-pet-codex-bridge",
  "version": "1.5.1",
  "private": true,
  "description": "Codex ↔ dsh-pet 桌面宠物（大肥鱼）联动：hook 事件、启动看门狗、本地补丁",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/patches/index.js",
    "check": "node hook.js --check",
    "launch": "node src/standalone-launcher.js",
    "watch": "node src/watch-codex.js",
    "diary": "node src/diary.js",
    "diary:list": "node src/diary.js --list",
    "diary:preview": "node src/diary.js --dry-run",
    "diary:view": "node src/diary.js --view",
    "diary:open": "node src/diary.js --open",
    "diary:rebuild": "node src/diary.js --rebuild",
    "impression": "node src/impressions.js",
    "impression:view": "node src/impressions.js --view",
    "impression:open": "node src/impressions.js --open",
    "pet:link": "node src/chat-link.js --link",
    "pet:unlink": "node src/chat-link.js --unlink",
    "pet:status": "node src/chat-link.js",
    "hooks": "node install/apply-hooks.js",
    "task:register": "powershell -NoProfile -ExecutionPolicy Bypass -File install/register-task.ps1",
    "task:unregister": "powershell -NoProfile -ExecutionPolicy Bypass -File install/unregister-task.ps1"
  }
}
